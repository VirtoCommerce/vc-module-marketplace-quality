{
  "name": "vcmp-quality",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "cross-env APP_ENV=production vite build",
    "build:modules-bundle": "yarn build",
    "build:watch": "cross-env APP_ENV=development vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-api-client": "cross-env api-client-generator --APP_PLATFORM_MODULES='[VirtoCommerce.CatalogQuality]' --APP_API_CLIENT_DIRECTORY=./src/api_client/"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.10.5",
    "@vc-shell/api-client-generator": "2.6.3-rc.0",
    "@vc-shell/ts-config": "2.6.3-rc.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.8",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.32",
    "sass": "^1.87.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.5"
  },
  "dependencies": {
    "@vc-shell/config-generator": "2.6.3-rc.0",
    "@vc-shell/framework": "2.6.3-rc.0",
    "@vc-shell/mf-module": "2.6.3-rc.0",
    "markdown-it": "^14.1.1",
    "vee-validate": "^4.12.4",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.3"
  },
  "packageManager": "yarn@4.9.2"
}
